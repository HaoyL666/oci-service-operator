{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "OCI Service Operator service chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "serviceAccount",
    "credentials",
    "auth",
    "manager",
    "resources",
    "podSecurityContext",
    "containerSecurityContext",
    "proxy"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "digest": {
                "const": ""
              }
            }
          },
          "then": {
            "properties": {
              "tag": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "name",
        "automountServiceAccountToken",
        "annotations"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "create": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "mountPath",
        "optional"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "legacyUseInstancePrincipal"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "",
            "user_principal",
            "security_token",
            "instance_principal",
            "instance_principal_with_certs",
            "resource_principal",
            "oke_workload_identity",
            "instance_principal_delegation_token",
            "resource_principal_delegation_token"
          ]
        },
        "legacyUseInstancePrincipal": {
          "type": "boolean"
        }
      }
    },
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "healthProbeBindAddress",
        "metricsBindAddress",
        "webhookPort",
        "leaderElection"
      ],
      "properties": {
        "healthProbeBindAddress": {
          "type": "string",
          "minLength": 1
        },
        "metricsBindAddress": {
          "type": "string",
          "minLength": 1
        },
        "webhookPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "leaderElection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "resourceName"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "resourceName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "$ref": "#/definitions/resourceList"
        },
        "requests": {
          "$ref": "#/definitions/resourceList"
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "seccompProfile": {
          "$ref": "#/definitions/seccompProfile"
        }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "add": {
              "$ref": "#/definitions/capabilityList"
            },
            "drop": {
              "$ref": "#/definitions/capabilityList"
            }
          }
        },
        "seccompProfile": {
          "$ref": "#/definitions/seccompProfile"
        }
      }
    },
    "customCA": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingConfigMap",
        "existingSecret",
        "key",
        "mountPath"
      ],
      "properties": {
        "existingConfigMap": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "not": {
        "properties": {
          "existingConfigMap": {
            "minLength": 1
          },
          "existingSecret": {
            "minLength": 1
          }
        },
        "required": [
          "existingConfigMap",
          "existingSecret"
        ]
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "httpProxy",
        "httpsProxy",
        "noProxy"
      ],
      "properties": {
        "httpProxy": {
          "type": "string"
        },
        "httpsProxy": {
          "type": "string"
        },
        "noProxy": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "definitions": {
    "resourceList": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "capabilityList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "seccompProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RuntimeDefault",
            "Localhost",
            "Unconfined"
          ]
        },
        "localhostProfile": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
