@startuml
skinparam shadowing false
skinparam backgroundColor #fcfcfd
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam arrowColor #0f172a
skinparam noteBackgroundColor #fff7d6
skinparam noteBorderColor #b45309
skinparam noteFontColor #334155
skinparam roundcorner 16
title Activity - databasemigration/Migration
skinparam activity {
  backgroundColor #f8fafc
  borderColor #0f172a
  fontColor #0f172a
  diamondBackgroundColor #e2e8f0
  diamondBorderColor #1d4ed8
  diamondFontColor #0f172a
  startColor #1d4ed8
  endColor #0f172a
  barColor #1d4ed8
}
start
partition "Observe and Bind" {
:Start from shared flow\nshared/diagrams/shared-reconcile-activity.svg;
:Read desired Migration spec, tracked status,\nand delete intent;
if ("Tracked or explicit OCI identity present?") then (yes)
:Get the current OCI resource via GetMigration;
else (no)
:Resolve an existing OCI resource through\nListMigrations using filters compartment_id,\ndisplay_name, lifecycle_details,\nlifecycle_state;
:Create the OCI resource via CreateMigration\nwhen no reusable match is found;
:Persist the resolved or created OCI identity\ninto status;
endif
}
if ("Delete requested?") then (yes)
partition "Delete" {
:Delete path uses DeleteMigration with required\nvia GetMigration or ListMigrations to DELETED\nconfirmation;
:Confirm deletion via GetMigration or\nListMigrations until OCI reaches DELETED;
if ("Delete cleanup and finalizer release succeed?") then (yes)
:Remove the finalizer after delete completion;
else (no)
:Stay blocked until cleanup or finalizer\nrelease succeeds;
endif
}
stop
else (no)
partition "Lifecycle Classification" {
if ("OCI state in retryable set?") then (yes)
:Request requeue while OCI remains in ACCEPTED,\nCREATING, IN_PROGRESS, WAITING (+2 more);
stop
endif
if ("OCI state is outside success targets?") then (yes)
:Return an unsuccessful reconcile result until\nOCI reaches ACTIVE, INACTIVE, SUCCEEDED;
stop
endif
}
partition "Ready and Drift Handling" {
:Compare live OCI state against the imported\nfield surface;
if ("Force-new or conflicting drift detected?") then (yes)
:Reject drift before OCI mutation for force-new\nfields assessment_id, compartment_id,\ndatabase_combination;
stop
endif
if ("Supported mutable drift detected?") then (yes)
:Apply UpdateMigration only for mutable fields\nadvanced_parameters, advisor_settings,\ndata_transfer_medium_details, defined_tags\n(+11 more);
else (no)
:Skip the no-op mutation path;
endif
:Run provider helper hooks\ncreate=tfresource.CreateResource,\ntfresource.WaitForWorkRequestWithErrorHandling\nentity=migration action=CREATED;\nupdate=tfresource.UpdateResource,\ntfresource.WaitForWorkRequestWithErrorHandling\nentity=migration action=UPDATED;\ndelete=tfresource.DeleteResource,\ntfresource.WaitForWorkRequestWithErrorHandling\nentity=migration action=DELETED when the\nmatching field-driven path executes;
:Return success for the ACTIVE, INACTIVE,\nSUCCEEDED success state;
:Project required status and finalizer policy\nretain-until-confirmed-delete;
:Requeue on provisioning, updating, terminating;
}
endif
stop
note right
shared diagram:
shared/diagrams/shared-reconcile-activity.svg
Start from the shared reconcile activity and
specialize provider-backed CRUD, wait, and
status-projection details here.
Controller-local activity diagrams add
list-lookup hints, secret policies, delete
handling, and open formal gaps.
archetype batch: Generated service-manager
controllers specialize the shared reconcile path
with formal runtime ownership.
service: databasemigration
slug: migration
kind: Migration
archetype: generated-service-manager
status/finalizer: required /
retain-until-confirmed-delete
requeue: provisioning, updating, terminating
provider states: create ACCEPTED, CREATING,
IN_PROGRESS, WAITING; update UPDATING; delete
DELETING
supported drift: advanced_parameters,
advisor_settings, data_transfer_medium_details,
defined_tags (+11 more)
reject before mutate: force-new fields
assessment_id, compartment_id,
database_combination
create-only fields: none
list lookup: oci_database_migration_migrations
filters compartment_id, display_name,
lifecycle_details, lifecycle_state
conflicts: none
open gaps: none
Work-request-backed generatedruntime overlay
with explicit MYSQL/ORACLE request builders,
conservative bind-before-create lookup,
helper-surface rejection, and required delete
confirmation.
end note
@enduml
